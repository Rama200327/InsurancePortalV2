@{
    ViewData["Title"] = "Medical Insurance";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-4">

        <h3 class="fw-bold text-primary mb-2">
            Medical Policy Issuance
        </h3>

        <p class="text-muted mb-0">
            Start a new medical insurance policy issuance process by providing customer and coverage details.
        </p>

    </div>

    <div class="card-body p-4">

        <div class="row">

            <div class="col-md-4">

                <div class="card border-primary h-100">
                    <div class="card-body text-center">

                        <i class="fa-solid fa-user fa-2x text-primary mb-3"></i>

                        <h5 class="fw-bold">
                            Customer Information
                        </h5>

                        <p class="text-muted small mb-0">
                            Enter customer personal and contact information.
                        </p>

                    </div>
                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-success h-100">
                    <div class="card-body text-center">

                        <i class="fa-solid fa-notes-medical fa-2x text-success mb-3"></i>

                        <h5 class="fw-bold">
                            Coverage Selection
                        </h5>

                        <p class="text-muted small mb-0">
                            Select the most suitable medical plan and network.
                        </p>

                    </div>
                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-warning h-100">
                    <div class="card-body text-center">

                        <i class="fa-solid fa-file-invoice-dollar fa-2x text-warning mb-3"></i>

                        <h5 class="fw-bold">
                            Quotation Review
                        </h5>

                        <p class="text-muted small mb-0">
                            Review quotation details before policy issuance.
                        </p>

                    </div>
                </div>

            </div>

        </div>

        <div class="alert alert-light border mt-4">

            <strong>Process Overview:</strong>

            The policy issuance workflow consists of customer information,
            coverage selection, quotation generation and final policy issuance.

        </div>

        <div class="d-flex justify-content-end mt-4">

            <a asp-controller="Medical"
               asp-action="Coverage"
               class="btn btn-primary px-5">

                Start Medical Insurance

            </a>

        </div>

    </div>

</div>