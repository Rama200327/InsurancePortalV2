@{
    ViewData["Title"] = "MedicalQuotation";
}
<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">
        <h4 class="fw-bold text-primary mb-1">
            Medical Quotation
        </h4>

        <small class="text-muted">
            Generate a quotation based on customer medical coverage requirements
        </small>
    </div>
</div>
    <div class="card-body p-4">

        <h5 class="fw-bold mb-3">
            Customer Information
        </h5>
</div>
       
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Customer Name</label>
                <input type="text"
                       class="form-control"
                       placeholder="Enter Customer Name" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">National ID</label>
                <input type="text"
                       class="form-control"
                       placeholder="National ID" />
            </div>
        </div>


        <div class="row">

            <div class="col-md-4 mb-3">
                <label class="form-label">Age</label>
                <input type="number"
                       class="form-control"
                       placeholder="Age" />
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Gender</label>
                <select class="form-select">
                    <option selected disabled>Select Gender</option>
                    <option>Male</option>
                    <option>Female</option>
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Mobile Number</label>
                <input type="text"
                       class="form-control"
                       placeholder="07XXXXXXXX" />
            </div>

        </div>

        <hr />

        <h5 class="fw-bold mb-3">
            Coverage Information
        </h5>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label class="form-label">
                    Coverage Type
                </label>

                <select class="form-select">
                    <option selected disabled>
                        Select Coverage Type
                    </option>
                    <option>Individual</option>
                    <option>Family</option>
                    <option>Corporate</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">
                    Network
                </label>

                <select class="form-select">
                    <option selected disabled>
                        Select Network
                    </option>
                    <option>Basic Network</option>
                    <option>Silver Network</option>
                    <option>Gold Network</option>
                    <option>VIP Network</option>
                </select>
            </div>

        </div>

        <hr />

        <h5 class="fw-bold mb-3">
            Available Plans
        </h5>

        <div class="row">

            <div class="col-md-4 mb-3">

                <div class="card border-primary h-100">

                    <div class="card-body">

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="plan"
                                   checked>

                            <label class="form-check-label fw-bold">
                                Basic Plan
                            </label>
                        </div>
            </div>
                        <hr />

                        <ul class="small">
                            <li>Outpatient</li>
                            <li>Inpatient</li>
                            <li>Emergency Coverage</li>
                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-4 mb-3">

                <div class="col-md-4 mb-3">

                    <div class="card border-success h-100">

                        <div class="card-body">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="radio"
                                       name="plan"
                                       id="silverPlan">

                                <label class="form-check-label fw-bold text-success"
                                       for="silverPlan">
                                    Silver Plan
                                </label>

                            </div>
            </div>

                            <hr />

                            <ul class="small mb-0">
                                <li>All Basic Benefits</li>
                                <li>Dental Coverage</li>
                                <li>Maternity Coverage</li>
                            </ul>

                        </div>

                    </div>

                </div>

                         