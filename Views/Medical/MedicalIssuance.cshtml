@{
    ViewData["Title"] = "Medical Insurance";
}
<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">

        <h4 class="fw-bold text-primary mb-1">
            Medical Coverage Selection
        </h4>
        <small class="text-muted">
            Select the most suitable medical coverage plan
        </small>

    </div>

    <div class="card-body p-4">
        <div class="row">

            <div class="col-md-4 mb-3">

                <div class="card border-primary h-100">

                    <div class="card-body">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="coverage"
                                   id="basicPlan"
                                   checked>

                            <label class="form-check-label fw-bold"
                                   for="basicPlan">
                                Basic Plan
                            </label>
                        </div>

                        <hr />

                        <ul class="small mb-0">
                            <li>Outpatient Treatment</li>
                            <li>Inpatient Coverage</li>
                            <li>Emergency Care</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">

                <div class="card border-success h-100">

                    <div class="card-body">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="coverage"
                                   id="silverPlan">

                            <label class="form-check-label fw-bold text-success"
                                   for="silverPlan">
                                Silver Plan
                            </label>
                        </div>
                        <hr />
                        <ul class="small mb-0">
                            <li>All Basic Benefits</li>
                            <li>Dental Coverage</li>
                            <li>Maternity Coverage</li>
                            <li>Extended Network</li>
                        </ul>

                    </div>

                </div>

            </div>

            <div class="col-md-4 mb-3">

                <div class="card border-warning h-100">

                    <div class="card-body">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="radio"
                                   name="coverage"
                                   id="goldPlan">

                            <label class="form-check-label fw-bold text-warning"
                                   for="goldPlan">
                                Gold Plan
                            </label>

                        </div>

                        <hr />

                        <ul class="small mb-0">
                            <li>Worldwide Coverage</li>
                            <li>VIP Network</li>
                            <li>High Annual Limits</li>
                            <li>Full Family Benefits</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-light border mt-4">

            <strong>Plan Summary:</strong>
            Selected medical coverage will determine the available
            healthcare network, annual limits and premium amount.
        </div>

        <div class="d-flex justify-content-between mt-4">

            <button type="button"
                    class="btn btn-outline-secondary px-4">
                Back
            </button>

            <button type="button"
                    class="btn btn-primary px-5">
                Continue
            </button>

        </div>

    </div>

</div>