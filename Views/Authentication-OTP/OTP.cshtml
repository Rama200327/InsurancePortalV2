@model InsuraV2.Models.OTP //Razor C#


//html
<div class="container mt-5">  

    <div class="card p-4">

        <h2>Enter OTP</h2>

        <form asp-action="OTP" method="post">

            <div class="mb-3">

                <label>OTP Code</label>

                <input asp-for="OtpCode""
                       id="otpCode"
                       class="form-control" />

            </div>

            <button type="submit"
                    class="btn btn-success">
                Verify
            </button> //bootstrap

        </form>

    </div>

</div>