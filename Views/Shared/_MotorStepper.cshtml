@{
    var currentStep = ViewBag.CurrentStep ?? 1;
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

        <div class="d-flex justify-content-center align-items-center flex-wrap gap-4">

            <div class="step-item @(currentStep >= 1 ? "active" : "")">
                <span>1</span>
                <small>Vehicle Information</small>
            </div>

            <div class="step-line"></div>

            <div class="step-item @(currentStep >= 2 ? "active" : "")">
                <span>2</span>
                <small>Customer Information</small>
            </div>

            <div class="step-line"></div>

            <div class="step-item @(currentStep >= 3 ? "active" : "")">
                <span>3</span>
                <small>Benefits & Coverage</small>
            </div>

            <div class="step-line"></div>

            <div class="step-item @(currentStep >= 4 ? "active" : "")">
                <span>4</span>
                <small>Payment Cycle</small>
            </div>

            <div class="step-line"></div>

            <div class="step-item @(currentStep >= 5 ? "active" : "")">
                <span>5</span>
                <small>Final Quotation</small>
            </div>

        </div>

    </div>
</div>