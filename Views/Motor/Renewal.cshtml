@{
    ViewBag.PageTitle = "Motor Renewal";

    ViewBag.PageDescription =
        "Manage motor policy renewals and current status.";
}
<!-- Header -->

<div class="mb-4">

    <h2 class="fw-bold">
        Motor Renewal
    </h2>

    <p class="text-muted mb-0">
        Manage motor policy renewals and current status.
    </p>

</div>

<!-- Card -->

<div class="card shadow-sm">

    <div class="card-body">

        <!-- Search -->

        <div class="d-flex justify-content-end mb-3">

            <button class="btn btn-outline-secondary me-2">

                Refresh

            </button>

            <button class="btn btn-outline-secondary">

                Export to Excel

            </button>

        </div>

        <div class="mb-4">

            <select class="form-select">

                <option>
                    Search by customer
                </option>

            </select>

        </div>

        <table class="table">

            <thead>

                <tr>

                    <th>Actions</th>
                    <th>Customer Name</th>
                    <th>Policy Number</th>
                    <th>Sum Insured</th>
                    <th>Expiry Date</th>
                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td colspan="6"
                        class="text-center text-muted py-5">

                        No data

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>